{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "tsc --outDir dist --esModuleInterop true app/*.ts app/**/*.ts",
    "pretestnet": "yarn build",
    "testnet": "node dist/app/testnet.js",
    "mint:usdc": "yarn build && node dist/app/plan/mint_usdc.js",
    "plan:init": "yarn build && node dist/app/plan/init.js",
    "plan:get_config": "yarn build && node dist/app/plan/get_config.js",
    "plan:add_building": "yarn build && node dist/app/plan/add_building.js",
    "plan:get_buildings": "yarn build && node dist/app/plan/get_buildings.js",
    "plan:add_plan": "yarn build && node dist/app/plan/add_plan.js",
    "plan:get_plans": "yarn build && node dist/app/plan/get_plans.js",
    "plan:subscribe": "yarn build && node dist/app/plan/subscribe.js",
    "plan:get_subscriptions": "yarn build && node dist/app/plan/get_subscriptions.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.2.1",
    "@metaplex-foundation/umi": "^0.9.2",
    "@solana/spl-token": "0.4.8",
    "@solana/web3.js": "^1.95.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.3.5"
  }
}
