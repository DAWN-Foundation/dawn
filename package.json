  "scripts": {
    "test": "cp target/deploy/dawn.so tests/fixtures && RUST_LOG= jest --runInBand --verbose",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "tsc --outDir dist --esModuleInterop true --skipLibCheck true --project .",
    "testnet": "yarn build && node dist/cli/environments/testnet.js",
    "devnet": "yarn build && node dist/cli/environments/devnet.js --devnet",
