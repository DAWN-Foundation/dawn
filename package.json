{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "tsc --outDir dist --esModuleInterop true --skipLibCheck true app/*.ts app/**/*.ts",
    "pretestnet": "yarn build",
    "testnet": "node dist/app/testnet.js",
    "mint:usdc": "yarn build && node dist/app/plan/mint_usdc.js",
    "dawn:init": "yarn build && node dist/app/plan/init.js",
    "dawn:get_config": "yarn build && node dist/app/plan/get_config.js",
    "dawn:add_building": "yarn build && node dist/app/plan/add_building.js",
    "dawn:get_buildings": "yarn build && node dist/app/plan/get_buildings.js",
    "dawn:add_plan": "yarn build && node dist/app/plan/add_plan.js",
    "dawn:get_plans": "yarn build && node dist/app/plan/get_plans.js",
    "dawn:subscribe": "yarn build && node dist/app/plan/subscribe.js",
    "dawn:get_subscriptions": "yarn build && node dist/app/plan/get_subscriptions.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/spl-token": "0.4.0",
    "@solana/web3.js": "^1.90.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^22.7.6",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.6.3"
  }
}
