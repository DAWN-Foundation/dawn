    "key:parse": "yarn build && node dist/cli/commands/utils/parse_key.js",
    "key:encrypt": "yarn build && node dist/sdk/utils/encrypt.js",
    "dawn:config": "yarn build && node dist/cli/commands/config/config.js",
    "dawn:init_metadata": "yarn build && node dist/cli/commands/config/init_metadata.js",
    "dawn:get_config": "yarn build && node dist/cli/commands/config/get_config.js",
    "dawn:deploy:set-program-id": "yarn build && node dist/cli/commands/deploy/set_program_id.js",
    "dawn:deploy:create-multisig": "yarn build && node dist/cli/commands/deploy/create_multisig.js",
    "dawn:deploy:add-member": "yarn build && node dist/cli/commands/deploy/add_member.js",
    "dawn:deploy:token-proposal": "yarn build && node dist/cli/commands/deploy/create_token_proposal.js",
    "dawn:deploy:config-proposal": "yarn build && node dist/cli/commands/deploy/create_config_proposal.js"
  },
